{
  "name": "morphp/medas-cache",
  "description": "Caches behind one interface: in memory, on the file system, in APCu and in Redis, plus decorators that index keys or refuse services",
  "keywords": [
    "storage",
    "backend"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-core": "^4",
    "morphp/medas-file-system": "^3",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\Cache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\CacheTest\\": "tests/"
    }
  }
}
